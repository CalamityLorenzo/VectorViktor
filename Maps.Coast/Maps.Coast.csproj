<Project Sdk="Microsoft.NET.Sdk">
  <!-- The coast map, built in code (see CoastMap): a station's plateau at one end, high land crossed by a river, and a
       sheer cliff down to a beach and the sea at the other; a station and a railway (see Station, Railway). A map library, like Maps.Home: it references World.Maps
       for what a map is, and any app that wants this map references it. -->
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\World.Maps\World.Maps.csproj" />
    <ProjectReference Include="..\World.Core\World.Core.csproj" />
    <ProjectReference Include="..\World.Buildings\World.Buildings.csproj" />
    <ProjectReference Include="..\MeshCore.Library\MeshCore.Library.csproj" />
    <ProjectReference Include="..\MeshProps\MeshProps.csproj" />
  </ItemGroup>
</Project>
