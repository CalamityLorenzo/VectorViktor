<Project>
  <!-- Shared by every project in the solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Warnings for nulls where they can't be: on for the libraries. The games, the older apps and the tests
         turn it off in their own project files, having been written without it. -->
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
