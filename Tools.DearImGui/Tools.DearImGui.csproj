<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dear ImGui (through Hexa.NET.ImGui) drawn by MonoGame, for the tools' panels: the playtest harness and the
       map studio. Dear ImGui builds the panels each frame and hands back triangles; ImGuiRenderer draws them, and
       feeds it the mouse and keyboard. See Lessons/02-drawing-dear-imgui.md. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsDX" />
    <PackageReference Include="Hexa.NET.ImGui" />
  </ItemGroup>
</Project>
